{
  "name": "dsh-egress",
  "version": "0.1.0",
  "private": true,
  "description": "Egress manager for DeepSeek Harness: choose which proxy (http, https, socks5 or direct) each model endpoint leaves the server through, fail-closed, from the Egress panel in the Web client. No configuration required: everything goes direct until an exit is added and bound. See README.md",
  "type": "module",
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "docs",
    "packages",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs",
    "install:profile": "node scripts/install.mjs"
  },
  "dependencies": {
    "dsh-host-egress": "file:./packages/host-egress",
    "dsh-client-ui-egress": "file:./packages/client-ui-egress"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}