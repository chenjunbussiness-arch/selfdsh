{
  "name": "dsh-host-egress",
  "version": "0.1.0",
  "private": true,
  "description": "Host half of dsh-egress: a fail-closed fetch hook that sends each model endpoint through the proxy a person picked, the exit store, the HTTP bridge and a read-only status tool",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/*.js", "lib/*.d.ts", "src", "README.md"],
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/validate.test.mjs tests/proxy.test.mjs tests/bridge.test.mjs"
  }
}