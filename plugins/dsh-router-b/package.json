{
  "name": "dsh-router-b",
  "version": "0.1.0",
  "private": true,
  "description": "Partition router bundle for DeepSeek Harness: the host plugin that routes work into file partitions and the Web client panel that shows it, joined by a same-origin HTTP bridge",
  "type": "module",
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "docs",
    "packages"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "install:profile": "node scripts/install.mjs"
  },
  "dependencies": {
    "dsh-host-router": "file:./packages/host-router",
    "dsh-client-ui-router": "file:./packages/client-ui-router"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
