{
  "name": "dsh-vpn",
  "version": "0.1.0",
  "private": true,
  "description": "VPN manager bundle for DeepSeek Harness: a host plugin that runs openfortivpn with split-tunnel routes and a watchdog, and a Web page to manage profiles, connect and read logs",
  "type": "module",
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "docs",
    "packages"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "install:profile": "node scripts/install.mjs",
    "preview": "node packages/client-ui-vpn/scripts/build-preview.mjs && node packages/client-ui-vpn/scripts/serve-preview.mjs"
  },
  "dependencies": {
    "dsh-host-vpn": "file:./packages/host-vpn",
    "dsh-client-ui-vpn": "file:./packages/client-ui-vpn"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
