# dsh-agent-hub 控制方配置（DSH 这一端）—— 示例
#
# 用法：复制本文件到  <DSH home>/agent-hub/controller.env  再填值。
#   DSH home = 环境变量 DSH_HOME，没设就是 ~/.dsh
#   Windows (MYDESK):  C:\Users\<你>\.dsh\agent-hub\controller.env
#   Linux 服务器:       /root/.dsh/agent-hub/controller.env   （chmod 600，里面有令牌）
#
# 千万不要把这些 DSH_ 开头的变量写进 <DSH home>/.env：那是 DSH 自己的凭据文件，
# 里面出现 DSH_ 变量 DSH 会拒绝启动。
#
# 本文件每次调用都会重新读取，改完不用重启 DSH。
# 优先级（每项单独算）：cordis.patch.yml 里显式写的 config > DSH 进程环境变量 > 本文件 > 默认值。
# 某项被 cordis.patch.yml 盖掉时，DSH 日志会提醒「controller.env 里的 X 被 cordis.patch.yml 覆盖了」。
# 格式：KEY=value；# 开头是注释；KEY= 留空等于没配。

# ---- MYDESK 版（Windows 工作站，连服务器上的 hub；默认直连）----------------------------

# 【必填】hub 地址：域名、IP 或完整 URL。裸地址会自动补成 https://<地址>:7891。
# 服务器 IP 可能会变，优先写域名；仓库里不写真实地址，按自己的环境填。
# 不填：工具和面板都回答 hub-not-configured。
DSH_HUB_URL=

# 【必填】本 DSH 在 hub 上的控制方 id（小写字母开头，字母/数字/-）。
# 必须和 hub 上 `node server.mjs controller add <id>` 用的 id 一致，也决定令牌前缀 dshc_<id>_。
# 不填：hub-not-configured。
DSH_HUB_CONTROLLER_ID=dsh-local

# 【可选】怎么连 hub。off / direct / none = 直连（默认，不强制走代理）；env = 用 HTTPS_PROXY 等环境变量；
# http://host:port = 固定走这个 HTTP 代理。直连不通、或 hub 拒绝了本机 IP 时，再改成 http://127.0.0.1:7890（Clash；7891 才是 hub）。
DSH_HUB_PROXY=off

# 【可选】hub 用自签证书时，填 hub 证书或 CA 的 PEM 文件绝对路径；用正规证书就留空（用系统 CA）。
# 自签证书却不填：报 hub-unreachable（TLS verification failed）。
DSH_HUB_CAFILE=

# 【必填】控制方令牌（dshc_dsh-local_...）。在 hub 机器上运行
#     node server.mjs controller add dsh-local
# 得到（只显示一次）。不填：工具和面板回答 hub-token-missing。DSH 日志只写来源，不写值。
DSH_HUB_TOKEN=

# ---- 服务器同机版（DSH 和 hub 在同一台服务器上，控制方 dsh-cloud）-------------
# 把上面五行换成：
#
# DSH_HUB_URL=https://127.0.0.1:7891
# DSH_HUB_CONTROLLER_ID=dsh-cloud
# DSH_HUB_PROXY=off
# DSH_HUB_CAFILE=/root/.dsh/agent-hub/hub-ca.pem     # hub 自签证书的 CA；证书 SAN 要包含 127.0.0.1
# DSH_HUB_TOKEN=                                      # node server.mjs controller add dsh-cloud
#
# （hub 没开 TLS、只监听回环时也可以 DSH_HUB_URL=http://127.0.0.1:7891，这时 DSH_HUB_CAFILE 必须留空。）
