{
  "name": "dsh-client-ui-fileshare",
  "description": "文件中转 page for the DSH Web client: create temporary download / upload links, copy them, see what arrived, revoke. Backed by the dsh-host-fileshare routes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs"
  }
}
