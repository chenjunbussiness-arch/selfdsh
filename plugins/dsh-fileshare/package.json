{
  "name": "dsh-fileshare",
  "version": "0.1.0",
  "private": true,
  "description": "File drop for DeepSeek Harness: agents and the 文件中转 page create temporary download / upload links (random token, expiry, revocation, allowed folders only, never an internal address), so files move without scp. Optional: publicBaseUrl, roots. See README.md",
  "type": "module",
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "packages",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test packages/host-fileshare/tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "install:profile": "node scripts/install.mjs"
  },
  "dependencies": {
    "dsh-host-fileshare": "file:./packages/host-fileshare",
    "dsh-client-ui-fileshare": "file:./packages/client-ui-fileshare"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
