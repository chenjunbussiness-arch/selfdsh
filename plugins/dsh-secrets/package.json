{
  "name": "dsh-secrets",
  "version": "0.1.0",
  "private": true,
  "description": "Local encrypted secret vault for DeepSeek Harness: agents can store and use secrets (env injection, HTTP placeholders) but never read them back, plus a write-only management page (vault, DSH credentials, agent-hub address, plugin needs). Required: the master passphrase DSH_SECRETS_PASSPHRASE in <DSH home>/secrets.env (not .env), or a keyfile. See README.md",
  "type": "module",
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "DESIGN.md",
    "icon.svg",
    "locale",
    "docs",
    "packages",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test packages/host-secrets/tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "install:profile": "node scripts/install.mjs"
  },
  "dependencies": {
    "dsh-host-secrets": "file:./packages/host-secrets",
    "dsh-client-ui-secrets": "file:./packages/client-ui-secrets"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
