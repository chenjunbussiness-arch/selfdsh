{
  "name": "dsh-client-ui-secrets",
  "description": "Secrets & plugins page for the DSH Web client: manage the dsh-secrets vault, DSH credentials and the agent-hub address, and see what each selfdsh plugin needs. Values are write-only; no view ever shows one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs"
  }
}
