{
  "name": "dsh-client-ui-token-stats",
  "description": "Sidebar token usage block for the DSH Web client: compact today total with per-model bars, expandable 7/30-day daily totals, backed by the dsh-host-token-stats read-only bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs"
  }
}
